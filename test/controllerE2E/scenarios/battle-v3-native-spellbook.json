{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v3.native-spellbook",
	"profile": "dualsense+xbox-series",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260827}
	},
	"timeout_ms": 90000,
	"fixture": {"setup": "battle-map-start", "map": "battle-e2e", "autofightPlayers": ["blue"]},
	"prelude": [{"op": "attach", "device": "pad0", "profile": "dualsense"}],
	"steps": [
		{"op": "wait_until", "probe": "runtime", "field": "top_window", "changes": true, "timeout_ms": 60000},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 36, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "hero_has_spellbook", "equals": true},
		{"op": "assert", "probe": "battle", "field": "hero_can_cast_spells", "equals": true},
		{"op": "tap", "device": "pad0", "control": "west"},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert_event_count", "kind": "shortcut_mouse_left_down", "count": 0},
		{"op": "assert_event_count", "kind": "shortcut_mouse_left_up", "count": 0},
		{"op": "capture_frame", "name": "m3-2-dualsense-square-spellbook"},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "touchpad_click"},
		{"op": "wait_until", "probe": "battle", "field": "cursor_mode", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "west"},
		{"op": "assert_event_count", "kind": "shortcut_mouse_left_down", "count": 1},
		{"op": "assert_event_count", "kind": "shortcut_mouse_left_up", "count": 1},
		{"op": "assert", "probe": "battle", "field": "spellbook_open", "equals": false},
		{"op": "assert", "probe": "battle", "field": "cursor_mode", "equals": true},
		{"op": "tap", "device": "pad0", "control": "touchpad_click"},
		{"op": "wait_until", "probe": "battle", "field": "native_mode", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "detach", "device": "pad0"},
		{"op": "attach", "device": "pad1", "profile": "xbox-series"},
		{"op": "tap", "device": "pad1", "control": "guide"},
		{"op": "wait_until", "probe": "runtime", "field": "presentation", "equals": "xbox", "timeout_ms": 3000},
		{"op": "tap", "device": "pad1", "control": "west"},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert_event_count", "kind": "shortcut_mouse_left_down", "count": 1},
		{"op": "assert_event_count", "kind": "shortcut_mouse_left_up", "count": 1},
		{"op": "capture_frame", "name": "m3-2-xbox-x-spellbook"},
		{"op": "request_shutdown"}
	]
}
