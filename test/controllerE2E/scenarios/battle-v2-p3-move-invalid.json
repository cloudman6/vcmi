{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v2.p3.move-invalid",
	"profile": "dualsense",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260814}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "battle-e2e",
		"autofightPlayers": ["blue"]
	},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "runtime", "field": "top_window", "changes": true, "timeout_ms": 60000},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 36, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 44, "timeout_ms": 8000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "wait_until", "probe": "battle", "field": "primary_action", "equals": "none", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "capture_frame", "name": "p3-invalid-no-move"},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "assert_unchanged", "probe": "battle", "field": "commands_sent", "frames": 12},
		{"op": "tap", "device": "pad0", "control": "dpad_left"},
		{"op": "assert_unchanged", "probe": "battle", "field": "focus_hex", "frames": 8},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "request_shutdown"}
	]
}
