{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v3.spellbook-multi-page",
	"profile": "dualsense",
	"settingsOverride": {
		"battle": {
			"enableQuickSpellPanel": true
		},
		"input": {
			"enableMouse": true
		},
		"server": {
			"seed": 20260901
		}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "battle-e2e-spellbook-pages",
		"autofightPlayers": [
			"blue"
		]
	},
	"manual": {
		"prelude": [],
		"steps": [
			{
				"op": "wait_until",
				"probe": "runtime",
				"field": "top_window",
				"changes": true,
				"timeout_ms": 60000
			},
			{
				"op": "wait_until",
				"probe": "battle",
				"field": "open",
				"equals": true,
				"timeout_ms": 60000,
				"stable_for_frames": 3
			},
			{"op": "manual_hold"}
		]
	},
	"prelude": [
		{
			"op": "attach",
			"device": "pad0",
			"profile": "dualsense"
		}
	],
	"steps": [
		{
			"op": "wait_until",
			"probe": "runtime",
			"field": "top_window",
			"changes": true,
			"timeout_ms": 60000
		},
		{"op": "move_mouse", "x": 760, "y": 560},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{
			"op": "wait_until",
			"probe": "battle",
			"field": "open",
			"equals": true,
			"timeout_ms": 20000
		},
		{"op": "tap", "device": "pad0", "control": "west"},
		{
			"op": "wait_until",
			"probe": "battle",
			"field": "spellbook_open",
			"equals": true,
			"timeout_ms": 3000,
			"stable_for_frames": 3
		},
		{"op": "capture_frame", "name": "spellbook-page-1"},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 1.0},
		{"op": "wait_frames", "frames": 10},
		{"op": "neutralize", "device": "pad0"},
		{"op": "capture_frame", "name": "spellbook-slot-focus-moved"},
		{"op": "set_axis", "device": "pad0", "control": "right_stick_x", "value": 1.0},
		{"op": "assert_unchanged", "probe": "runtime", "field": "cursor_position_x", "frames": 8},
		{"op": "neutralize", "device": "pad0"},
		{"op": "tap", "device": "pad0", "control": "r1"},
		{"op": "wait_frames", "frames": 10},
		{"op": "capture_frame", "name": "spellbook-page-2"},
		{"op": "tap", "device": "pad0", "control": "l1"},
		{"op": "wait_frames", "frames": 10},
		{"op": "capture_frame", "name": "spellbook-page-1-returned"},
		{"op": "tap", "device": "pad0", "control": "dpad_right"},
		{"op": "wait_frames", "frames": 10},
		{"op": "capture_frame", "name": "spellbook-adventure-tab"},
		{"op": "tap", "device": "pad0", "control": "dpad_left"},
		{"op": "wait_frames", "frames": 10},
		{"op": "press", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "navigation", "field": "top_window_is_popup", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "spellbook-focused-popup"},
		{"op": "release", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "navigation", "field": "top_window_is_popup", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_frames", "frames": 8},
		{"op": "capture_frame", "name": "spellbook-next-school"},
		{"op": "tap", "device": "pad0", "control": "dpad_up"},
		{"op": "wait_frames", "frames": 8},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "wait_until", "probe": "battle", "field": "hero_spellcasting_mode", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "battle", "field": "hero_spellcasting_mode", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "west"},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "west"},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "move_mouse", "x": 670, "y": 580},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "tap", "device": "pad0", "control": "touchpad_click"},
		{"op": "wait_until", "probe": "battle", "field": "cursor_mode", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "west"},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "west"},
		{"op": "assert_unchanged", "probe": "battle", "field": "spellbook_open", "frames": 8},
		{"op": "move_mouse", "x": 125, "y": 95},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "capture_frame", "name": "spellbook-mouse-hover-full-slot"},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "battle", "field": "spellbook_open", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "request_shutdown"}
	]
}
