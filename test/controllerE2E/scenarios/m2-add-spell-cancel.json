{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m2.add-spell.cancel-with-takeover",
	"profile": "dualsense",
	"timeout_ms": 30000,
	"fixture": {"setup": "battle-only-add-spell"},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": true, "timeout_ms": 10000},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "addSpell", "field": "focus_index", "equals": 1, "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "capture_frame", "name": "controller-mode-before-takeover"},
		{"op": "click_mouse", "button": "left", "x": 400, "y": 80},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "keyboard_and_mouse", "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": false, "timeout_ms": 2000},
		{"op": "capture_frame", "name": "mouse-mode-takeover"},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "controller", "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "capture_frame", "name": "controller-restored"},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "addSpell", "field": "cancel_count", "equals": 1, "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": false, "timeout_ms": 2000},
		{"op": "capture_frame", "name": "add-spell-after-cancel"},
		{"op": "request_shutdown"}
	]
}
