{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m4.contract.shared-radial",
	"profile": "dualsense",
	"settingsOverride": {"input": {"enableMouse": true}, "server": {"seed": 20260905}},
	"timeout_ms": 90000,
	"fixture": {"setup": "battle-map-start", "map": "adventure-visible-enemy-e2e", "autofightPlayers": []},
	"prelude": [{"op": "attach", "device": "pad0", "profile": "dualsense"}],
	"steps": [
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 60000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "context_radial.slot_count", "equals": 12},
		{"op": "assert", "probe": "controller_object_focus", "field": "context_radial.page_shortcuts_configured", "equals": true},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "neutralize", "device": "pad0"},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.open", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "request_shutdown"}
	]
}
