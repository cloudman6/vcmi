{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m2.remove-spell.xbox-prompts",
	"profile": "xbox-series",
	"timeout_ms": 30000,
	"fixture": {"setup": "battle-only-remove-spell", "preselected": [0, 1, 2]},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "xbox-series"}
	],
	"steps": [
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": true, "timeout_ms": 10000},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "controller", "timeout_ms": 2000},
		{"op": "assert", "probe": "runtime", "field": "presentation", "equals": "xbox"},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "addSpell", "field": "cancel_visual_visible", "equals": true},
		{"op": "assert", "probe": "addSpell", "field": "accept_glyph_text", "equals": "Remove"},
		{"op": "assert", "probe": "addSpell", "field": "cancel_glyph_text", "equals": "Cancel"},
		{"op": "capture_frame", "name": "remove-spell-xbox-action-prompts"},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": false, "timeout_ms": 2000},
		{"op": "assert", "probe": "domain", "field": "spell_count", "equals": 3},
		{"op": "request_shutdown"}
	]
}
