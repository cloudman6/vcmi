{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v2.p3.move-success",
	"profile": "dualsense",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260814}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "battle-e2e",
		"autofightPlayers": ["blue"]
	},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "runtime", "field": "top_window", "changes": true, "timeout_ms": 60000},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 36, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "active_stack.id", "equals": 0},
		{"op": "assert", "probe": "battle", "field": "stacks_by_id.id_0.double_wide", "equals": true},
		{"op": "assert", "probe": "battle", "field": "stacks_by_id.id_0.occupied_position", "equals": 35},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 0.5},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_y", "value": 0.9},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 54, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "wait_until", "probe": "battle", "field": "primary_action", "equals": "move", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "capture_frame", "name": "p3-double-wide-native-move"},
		{"op": "capture_region", "name": "p3-double-wide-native-target", "x": 132, "y": 200, "w": 72, "h": 72},
		{"op": "move_mouse", "x": 168, "y": 234},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "hovered_hex", "equals": 54, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "p3-double-wide-mouse-move"},
		{"op": "capture_region", "name": "p3-double-wide-mouse-target", "x": 132, "y": 200, "w": 72, "h": 72},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "controller", "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "primary_action", "equals": "move", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "press", "device": "pad0", "control": "south"},
		{"op": "wait_frames", "frames": 4},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "assert", "probe": "battle", "field": "focus_cursor_drawn", "equals": true},
		{"op": "assert", "probe": "battle", "field": "action_prompt_drawn", "equals": true},
		{"op": "capture_frame", "name": "p3-double-wide-move-pressed"},
		{"op": "release", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "commands_sent", "equals": 1, "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "focus_cursor_drawn", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "action_prompt_drawn", "equals": false},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "assert", "probe": "runtime", "field": "cursor_backend_visible", "equals": false},
		{"op": "capture_frame", "name": "p3-double-wide-move-in-flight"},
		{"op": "wait_until", "probe": "battle", "field": "stacks_by_id.id_0.position", "equals": 54, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "stacks_by_id.id_0.occupied_position", "equals": 53},
		{"op": "wait_until", "probe": "battle", "field": "active_stack.id", "equals": 1, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "focus_hex", "equals": 137},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 138, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "wait_until", "probe": "battle", "field": "primary_action", "equals": "move", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "commands_sent", "equals": 2, "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "stacks_by_id.id_1.position", "equals": 138, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "p3-single-wide-move-result"},
		{"op": "request_shutdown"}
	]
}
