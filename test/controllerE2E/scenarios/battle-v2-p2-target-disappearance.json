{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v2.p2.target-disappearance",
	"profile": "dualsense",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260814}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "battle-e2e-disappearance",
		"autofightPlayers": ["blue"]
	},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "runtime", "field": "top_window", "changes": true, "timeout_ms": 60000},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 36, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "right_stick_x", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 49, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "battle", "field": "focused_stack.id", "equals": 2},
		{"op": "wait_until", "probe": "battle", "field": "primary_action", "equals": "inspect", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "inspect_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "inspect_open", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "press_key", "key": "d"},
		{"op": "wait_frames", "frames": 2},
		{"op": "release_key", "key": "d"},
		{"op": "wait_frames", "frames": 120},
		{"op": "assert", "probe": "battle", "field": "active_stack.id", "equals": 1},
		{"op": "move_mouse", "x": 740, "y": 191},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "assert", "probe": "battle", "field": "hovered_hex", "equals": 49},
		{"op": "click_mouse", "button": "left", "x": 740, "y": 191},
		{"op": "wait_frames", "frames": 120},
		{"op": "wait_until", "probe": "battle", "field": "alive_unit_ids", "equals": [0, 1, 3], "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 2},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "controller", "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "hovered_hex", "equals": 49, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "focus_hex", "equals": 49},
		{"op": "assert", "probe": "battle", "field": "primary_action", "equals": "none"},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 2},
		{"op": "capture_frame", "name": "p2-target-disappearance-recovery"},
		{"op": "request_shutdown"}
	]
}
