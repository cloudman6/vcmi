		{"op": "wait_until", "probe": "controller_object_focus", "field": "kind", "equals": "tile", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "controller_object_focus", "field": "target_x", "equals": 5},
		{"op": "assert", "probe": "controller_object_focus", "field": "target_y", "equals": 18},
		{"op": "assert", "probe": "controller_object_focus", "field": "target_has_object", "equals": false},
		{"op": "assert", "probe": "controller_object_focus", "field": "target_active_object_visitable_at", "equals": true},
		{"op": "assert", "probe": "controller_object_focus", "field": "target_path_action", "equals": 5},
		{"op": "assert", "probe": "controller_object_focus", "field": "target_path_reachable", "equals": true},
		{"op": "assert", "probe": "controller_object_focus", "field": "target_path_has_predecessor", "equals": true},
		{"op": "assert", "probe": "runtime", "field": "cursor_id", "equals": "mapTurn1Visit"},
		{"op": "assert", "probe": "controller_object_focus", "field": "path_end_x", "equals": -1},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_kind", "equals": "hero"},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_visitable_x", "equals": 11},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_visitable_y", "equals": 18},
		{"op": "assert", "probe": "controller_object_focus", "field": "primary_attempts", "equals": 1},
		{"op": "assert", "probe": "controller_object_focus", "field": "path_end_x", "equals": 5},
		{"op": "assert", "probe": "controller_object_focus", "field": "path_end_y", "equals": 18},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "path_matches_interaction_target", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "scene", "field": "town_window_open", "equals": false},
		{"op": "capture_frame", "name": "adventure-town-entrance-route"},
		{"op": "set_axis", "device": "pad0", "control": "right_stick_y", "value": -1.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "kind", "equals": "town", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "runtime", "field": "cursor_id", "equals": "mapTown"},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "scene", "field": "town_window_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "adventure-town-object-open"},
		{"op": "request_shutdown"}
	]
