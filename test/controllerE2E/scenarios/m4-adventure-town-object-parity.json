{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m4.adventure.town-object-parity",
	"profile": "dualsense",
	"settingsOverride": {"input": {"enableMouse": true}, "server": {"seed": 20260904}},
	"timeout_ms": 90000,
	"fixture": {"setup": "battle-map-start", "map": "adventure-visible-enemy-e2e", "autofightPlayers": []},
	"prelude": [{"op": "attach", "device": "pad0", "profile": "dualsense"}],
