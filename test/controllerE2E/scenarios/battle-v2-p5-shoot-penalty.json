{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v2.p5.shoot-penalty",
	"profile": "dualsense",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260814}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "battle-e2e",
		"autofightPlayers": ["blue"]
	},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "runtime", "field": "top_window", "changes": true, "timeout_ms": 60000},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 36, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 0.5},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_y", "value": 0.9},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 54, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "commands_sent", "equals": 1, "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "stacks_by_id.id_0.position", "equals": 54, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "wait_until", "probe": "battle", "field": "active_stack.id", "equals": 1, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "focus_hex", "equals": 137},
		{"op": "set_axis", "device": "pad0", "control": "right_stick_x", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "focused_stack.id", "equals": 2, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "battle", "field": "focus_hex", "equals": 100},
		{"op": "wait_until", "probe": "battle", "field": "primary_action", "equals": "shoot", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "shoot_disabled_reason", "equals": "none"},
		{"op": "assert", "probe": "runtime", "field": "cursor_id", "equals": "combatShootPenalty"},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "assert", "probe": "battle", "field": "action_prompt_drawn", "equals": true},
		{"op": "capture_frame", "name": "p5-shoot-penalty-ready"},
		{"op": "capture_region", "name": "p5-shoot-penalty-target", "x": 650, "y": 155, "w": 210, "h": 210},
		{"op": "move_mouse", "x": 699, "y": 322},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "hovered_hex", "equals": 100, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "runtime", "field": "cursor_id", "equals": "combatShootPenalty"},
		{"op": "capture_frame", "name": "p5-shoot-penalty-mouse"},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "controller", "timeout_ms": 3000},
		{"op": "assert", "probe": "battle", "field": "focus_hex", "equals": 100},
		{"op": "assert", "probe": "battle", "field": "primary_action", "equals": "shoot"},
		{"op": "assert", "probe": "runtime", "field": "cursor_id", "equals": "combatShootPenalty"},
		{"op": "capture_frame", "name": "p5-shoot-penalty-controller-restored"},
		{"op": "press", "device": "pad0", "control": "south"},
		{"op": "wait_frames", "frames": 4},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 1},
		{"op": "release", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "commands_sent", "equals": 2, "timeout_ms": 3000},
		{"op": "assert", "probe": "battle", "field": "last_command.type", "equals": 9},
		{"op": "assert", "probe": "battle", "field": "last_command.actor_id", "equals": 1},
		{"op": "assert", "probe": "battle", "field": "last_command.target_count", "equals": 1},
		{"op": "assert", "probe": "battle", "field": "last_command.target_0", "equals": 100},
		{"op": "wait_until", "probe": "battle", "field": "stacks_by_id.id_2.available_health", "changes": true, "timeout_ms": 20000},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "capture_frame", "name": "p5-shoot-penalty-result"},
		{"op": "request_shutdown"}
	]
}
