{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m2.add-spell.controller-family-switch",
	"profile": "synthetic-generic+dualsense",
	"timeout_ms": 30000,
	"fixture": {"setup": "battle-only-add-spell"},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "synthetic-generic"},
		{"op": "attach", "device": "pad1", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": true, "timeout_ms": 10000},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "controller", "timeout_ms": 2000},
		{"op": "assert", "probe": "runtime", "field": "presentation", "equals": "generic"},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "tap", "device": "pad1", "control": "dpad_down"},
		{"op": "wait_until", "probe": "runtime", "field": "presentation", "equals": "playstation", "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "detach", "device": "pad1"},
		{"op": "wait_until", "probe": "runtime", "field": "presentation", "equals": "unknown", "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": false, "timeout_ms": 2000},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": true},
		{"op": "reconnect", "device": "pad1"},
		{"op": "tap", "device": "pad1", "control": "dpad_down"},
		{"op": "wait_until", "probe": "runtime", "field": "presentation", "equals": "playstation", "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "runtime", "field": "presentation", "equals": "generic", "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "capture_frame", "name": "generic-controller-restored-keycaps"},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": false, "timeout_ms": 2000},
		{"op": "request_shutdown"}
	]
}
