{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m2.add-spell.xbox-disabled-prompt",
	"profile": "xbox-series",
	"timeout_ms": 30000,
	"fixture": {"setup": "battle-only-add-spell"},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "xbox-series"}
	],
	"steps": [
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": true, "timeout_ms": 10000},
		{"op": "click_mouse", "button": "left", "x": 400, "y": 187},
		{"op": "text_input", "text": "no-such-spell"},
		{"op": "wait_until", "probe": "addSpell", "field": "focused_enabled", "equals": false, "timeout_ms": 2000},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "controller", "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "addSpell", "field": "accept_prompt_sprite", "equals": "controllerActionBar/xbox-a-disabled.png"},
		{"op": "assert", "probe": "addSpell", "field": "accept_prompt_label", "equals": "A"},
		{"op": "assert", "probe": "addSpell", "field": "cancel_prompt_sprite", "equals": "controllerActionBar/xbox-b-normal.png"},
		{"op": "assert", "probe": "addSpell", "field": "cancel_prompt_label", "equals": "B"},
		{"op": "capture_frame", "name": "xbox-action-prompts-disabled"},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": false, "timeout_ms": 2000},
		{"op": "request_shutdown"}
	]
}
