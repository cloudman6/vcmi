{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m4.contract.spellbook-reuse",
	"profile": "dualsense",
	"settingsOverride": {"input": {"enableMouse": true}, "server": {"seed": 20260905}},
	"timeout_ms": 90000,
	"fixture": {"setup": "battle-map-start", "map": "adventure-visible-enemy-e2e", "autofightPlayers": []},
	"prelude": [{"op": "attach", "device": "pad0", "profile": "dualsense"}],
	"steps": [
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 60000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.open", "equals": true, "timeout_ms": 3000},
		{"op": "neutralize", "device": "pad0"},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 0.8},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_y", "value": -0.8},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.selected", "equals": "spellbook", "timeout_ms": 3000},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "scene", "field": "spellbook_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "press", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "navigation", "field": "top_window_is_popup", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "adventure-spellbook-native-secondary-popup"},
		{"op": "release", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "navigation", "field": "top_window_is_popup", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "scene", "field": "spellbook_open", "equals": true},
		{"op": "request_shutdown"}
	]
}
