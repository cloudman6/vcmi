{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v2.p5.shoot-disabled-adjacent",
	"profile": "dualsense",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260814}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "battle-e2e-shoot-blocked",
		"autofightPlayers": ["blue"]
	},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "runtime", "field": "top_window", "changes": true, "timeout_ms": 60000},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 86, "timeout_ms": 30000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "active_stack.id", "equals": 0},
		{"op": "set_axis", "device": "pad0", "control": "right_stick_x", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "focused_stack.id", "equals": 1, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "battle", "field": "primary_action", "equals": "attack"},
		{"op": "assert", "probe": "battle", "field": "shoot_disabled_reason", "equals": "blocked_by_adjacent_enemy"},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "capture_frame", "name": "p5-shoot-disabled-adjacent"},
		{"op": "request_shutdown"}
	]
}
