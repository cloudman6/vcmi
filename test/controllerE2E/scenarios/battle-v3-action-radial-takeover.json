{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v3.action-radial-takeover",
	"profile": "dualsense",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260829}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "battle-e2e-creature-spell",
		"autofightPlayers": ["blue"]
	},
	"prelude": [{"op": "attach", "device": "pad0", "profile": "dualsense"}],
	"steps": [
		{"op": "wait_until", "probe": "runtime", "field": "top_window", "changes": true, "timeout_ms": 60000},
		{"op": "press", "device": "pad0", "control": "ps"},
		{"op": "wait_frames", "frames": 2},
		{"op": "release", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "battle", "field": "active_stack.type", "equals": "core:stormElemental", "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": true, "timeout_ms": 3000},
		{"op": "neutralize", "device": "pad0"},
		{"op": "wait_frames", "frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": -0.9},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_y", "value": -0.5},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.selected", "equals": "creature:core:protectAir", "timeout_ms": 3000},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": false, "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "controller_context_mode", "equals": true, "timeout_ms": 3000},
		{"op": "move_mouse", "x": 400, "y": 300},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "assert", "probe": "battle", "field": "controller_context_mode", "equals": true},
		{"op": "assert", "probe": "battle", "field": "creature_spellcasting_mode", "equals": true},
		{"op": "press", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "controller", "timeout_ms": 3000},
		{"op": "release", "device": "pad0", "control": "ps"},
		{"op": "wait_frames", "frames": 2},
		{"op": "neutralize", "device": "pad0"},
		{"op": "wait_frames", "frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": true, "timeout_ms": 3000},
		{"op": "neutralize", "device": "pad0"},
		{"op": "wait_frames", "frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": -0.9},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_y", "value": -0.5},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.selected", "equals": "creature:core:protectAir", "timeout_ms": 3000},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": false, "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "controller_context_mode", "equals": true, "timeout_ms": 3000},
		{"op": "detach", "device": "pad0"},
		{"op": "assert", "probe": "battle", "field": "controller_context_mode", "equals": true},
		{"op": "assert", "probe": "battle", "field": "creature_spellcasting_mode", "equals": true},
		{"op": "request_shutdown"}
	]
}
