{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m2.add-spell.xbox-custom-face-bindings",
	"profile": "xbox-series",
	"timeout_ms": 30000,
	"fixture": {
		"setup": "battle-only-add-spell",
		"joystickButtonBindings": {
			"globalAccept": "x",
			"globalCancel": "y"
		}
	},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "xbox-series"}
	],
	"steps": [
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": true, "timeout_ms": 10000},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "controller", "timeout_ms": 2000},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "addSpell", "field": "accept_prompt_sprite", "equals": "controllerActionBar/xbox-x-normal.png"},
		{"op": "assert", "probe": "addSpell", "field": "cancel_prompt_sprite", "equals": "controllerActionBar/xbox-y-normal.png"},
		{"op": "assert", "probe": "addSpell", "field": "accept_prompt_label", "equals": "X"},
		{"op": "assert", "probe": "addSpell", "field": "cancel_prompt_label", "equals": "Y"},
		{"op": "press", "device": "pad0", "control": "west"},
		{"op": "wait_frames", "frames": 2},
		{"op": "assert", "probe": "addSpell", "field": "accept_prompt_sprite", "equals": "controllerActionBar/xbox-x-pressed.png"},
		{"op": "assert", "probe": "addSpell", "field": "accept_prompt_label", "equals": "X"},
		{"op": "release", "device": "pad0", "control": "west"},
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": false, "timeout_ms": 2000},
		{"op": "assert", "probe": "domain", "field": "spell_count", "equals": 1},
		{"op": "request_shutdown"}
	]
}
