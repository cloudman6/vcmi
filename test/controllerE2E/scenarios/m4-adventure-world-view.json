{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m4.adventure.world-view",
	"profile": "dualsense",
	"settingsOverride": {"input": {"enableMouse": true}, "server": {"seed": 20260904}},
	"timeout_ms": 90000,
	"fixture": {"setup": "battle-map-start", "map": "adventure-visible-enemy-e2e", "autofightPlayers": []},
	"prelude": [{"op": "attach", "device": "pad0", "profile": "dualsense"}],
	"steps": [
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 60000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "primary_attempts", "equals": 0},
		{"op": "press", "device": "pad0", "control": "south"},
		{"op": "tap", "device": "pad0", "control": "dpad_up"},
		{"op": "wait_until", "probe": "scene", "field": "world_view", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "release", "device": "pad0", "control": "south"},
		{"op": "assert", "probe": "controller_object_focus", "field": "primary_attempts", "equals": 0},
		{"op": "press", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "scene", "field": "world_view", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "release", "device": "pad0", "control": "south"},
		{"op": "assert_unchanged", "probe": "controller_object_focus", "field": "primary_attempts", "frames": 8},
		{"op": "assert", "probe": "scene", "field": "hero_window_open", "equals": false},
		{"op": "tap", "device": "pad0", "control": "dpad_up"},
		{"op": "wait_until", "probe": "scene", "field": "world_view", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "adventure-world-view"},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_frames", "frames": 4},
		{"op": "assert", "probe": "controller_object_focus", "field": "context_radial.open", "equals": false},
		{"op": "neutralize", "device": "pad0"},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 1.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "target_x", "changes": true, "timeout_ms": 3000},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_id", "equals": 0},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "scene", "field": "world_view", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "dpad_up"},
		{"op": "wait_until", "probe": "scene", "field": "world_view", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "adventure-after-world-view"},
		{"op": "request_shutdown"}
	]
}
