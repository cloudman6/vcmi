{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m4.adventure.actor-selection",
	"profile": "dualsense",
	"settingsOverride": {"input": {"enableMouse": true}, "server": {"seed": 20260904}},
	"timeout_ms": 90000,
	"fixture": {"setup": "battle-map-start", "map": "adventure-visible-enemy-e2e", "autofightPlayers": []},
	"prelude": [{"op": "attach", "device": "pad0", "profile": "dualsense"}],
	"steps": [
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 60000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_kind", "equals": "hero"},
		{"op": "assert", "probe": "controller_object_focus", "field": "hero_count", "equals": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "town_count", "equals": 1},
		{"op": "tap", "device": "pad0", "control": "l1"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": 2, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "kind", "equals": "hero"},
		{"op": "tap", "device": "pad0", "control": "r1"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_kind", "equals": "town", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "kind", "equals": "town"},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "scene", "field": "town_window_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_kind", "equals": "town"},
		{"op": "capture_frame", "name": "adventure-actor-selection"},
		{"op": "tap", "device": "pad0", "control": "l1"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": 0, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "authority_swap_adventure_heroes", "first_index": 1, "second_index": 2},
		{"op": "tap", "device": "pad0", "control": "l1"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": 3, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "l1"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": 2, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "authority_remove_adventure_object", "object_id": 2},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": 0, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "id", "equals": 0, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "authority_remove_adventure_object", "object_id": 0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": 3, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "target_actor_aligned", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "authority_remove_adventure_object", "object_id": 3},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "hero_count", "equals": 0, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_kind", "equals": "town", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "id", "equals": 4, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "authority_remove_adventure_object", "object_id": 4},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": -1, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "id", "equals": -1, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "town_count", "equals": 0},
		{"op": "capture_frame", "name": "adventure-empty-actor-lists"},
		{"op": "request_shutdown"}
	]
}
