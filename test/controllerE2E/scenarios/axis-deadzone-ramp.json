{
	"schema": "vcmi.controller-e2e/v1",
	"id": "axis.deadzone-and-ramp",
	"profile": "dualsense",
	"timeout_ms": 30000,
	"fixture": {},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_frames", "frames": 5},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 0.1},
		{"op": "wait_frames", "frames": 10},
		{"op": "assert", "probe": "input", "field": "mode", "equals": "keyboard_and_mouse"},
		{"op": "neutralize", "device": "pad0"},
		{"op": "wait_frames", "frames": 3},
		{"op": "ramp_axis", "device": "pad0", "control": "left_stick_x", "from": 0.0, "to": 1.0, "frames": 10},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "controller", "timeout_ms": 2000},
		{"op": "neutralize", "device": "pad0"},
		{"op": "wait_frames", "frames": 5},
		{"op": "set_axis", "device": "pad0", "control": "l2", "value": 0.3},
		{"op": "assert_unchanged", "probe": "input", "field": "mode", "frames": 5},
		{"op": "neutralize", "device": "pad0"},
		{"op": "capture_frame", "name": "axis-neutralized"},
		{"op": "request_shutdown"}
	]
}
