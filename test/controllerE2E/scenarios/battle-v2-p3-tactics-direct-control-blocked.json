		{"op": "wait_until", "probe": "battle", "field": "hovered_hex", "equals": 37, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "runtime", "field": "cursor_id", "equals": "combatFly"},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "controller", "timeout_ms": 3000},
		{"op": "assert", "probe": "battle", "field": "primary_action", "equals": "none"},
		{"op": "set_axis", "device": "pad0", "control": "l2", "value": 1.0},
		{"op": "wait_frames", "frames": 4},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "battle", "field": "active_stack.id", "equals": 0},
		{"op": "assert", "probe": "battle", "field": "focus_hex", "equals": 37},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_frames", "frames": 4},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "assert", "probe": "battle", "field": "tactics_mode", "equals": true},
		{"op": "request_shutdown"}
	]
