{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m4.adventure.input-lifecycle",
	"profile": "dualsense",
	"settingsOverride": {"input": {"enableMouse": true}, "server": {"seed": 20260904}},
	"timeout_ms": 90000,
	"fixture": {"setup": "battle-map-start", "map": "adventure-visible-enemy-e2e", "autofightPlayers": []},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"},
		{"op": "attach", "device": "pad1", "profile": "xbox-series"}
	],
	"steps": [
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 60000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "l2", "value": 1.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "camera_held", "equals": true, "timeout_ms": 3000},
		{"op": "set_axis", "device": "pad1", "control": "lt", "value": 1.0},
		{"op": "wait_until", "probe": "runtime", "field": "presentation", "equals": "xbox", "timeout_ms": 3000},
		{"op": "assert", "probe": "controller_object_focus", "field": "camera_held", "equals": true},
		{"op": "set_axis", "device": "pad0", "control": "l2", "value": 0.0},
		{"op": "assert_unchanged", "probe": "controller_object_focus", "field": "camera_held", "frames": 8},
		{"op": "set_axis", "device": "pad1", "control": "lt", "value": 0.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "camera_held", "equals": false, "timeout_ms": 3000},
		{"op": "press", "device": "pad0", "control": "south"},
		{"op": "assert", "probe": "controller_object_focus", "field": "primary_attempts", "equals": 0},
		{"op": "press", "device": "pad1", "control": "south"},
		{"op": "wait_until", "probe": "runtime", "field": "presentation", "equals": "xbox", "timeout_ms": 3000},
		{"op": "release", "device": "pad0", "control": "south"},
		{"op": "assert_unchanged", "probe": "controller_object_focus", "field": "primary_attempts", "frames": 8},
		{"op": "release", "device": "pad1", "control": "south"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "primary_attempts", "equals": 1, "timeout_ms": 3000},
		{"op": "wait_until", "probe": "scene", "field": "hero_window_open", "equals": true, "timeout_ms": 3000},
		{"op": "tap", "device": "pad1", "control": "east"},
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 3000},
		{"op": "press", "device": "pad1", "control": "south"},
		{"op": "assert_unchanged", "probe": "controller_object_focus", "field": "primary_attempts", "frames": 2},
		{"op": "move_mouse", "x": 600, "y": 300},
		{"op": "wait_until", "probe": "input", "field": "mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "release", "device": "pad1", "control": "south"},
		{"op": "assert_unchanged", "probe": "controller_object_focus", "field": "primary_attempts", "frames": 8},
		{"op": "set_axis", "device": "pad1", "control": "rt", "value": 1.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.open", "equals": true, "timeout_ms": 3000},
		{"op": "set_axis", "device": "pad1", "control": "left_stick_x", "value": 0.8},
		{"op": "set_axis", "device": "pad1", "control": "left_stick_y", "value": -0.8},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.selected", "equals": "spellbook", "timeout_ms": 3000},
		{"op": "capture_frame", "name": "adventure-context-radial-xbox"},
		{"op": "detach", "device": "pad1"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.open", "equals": false, "timeout_ms": 3000},
		{"op": "assert", "probe": "controller_object_focus", "field": "primary_attempts", "equals": 1},
		{"op": "request_shutdown"}
	]
}
