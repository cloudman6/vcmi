{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m2.add-spell.confirm",
	"profile": "dualsense",
	"timeout_ms": 30000,
	"fixture": {"setup": "battle-only-add-spell"},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": true, "timeout_ms": 10000},
		{"op": "assert", "probe": "domain", "field": "spell_count", "equals": 0},
		{"op": "assert", "probe": "addSpell", "field": "focus_index", "equals": 0},
		{"op": "assert", "probe": "addSpell", "field": "focused_enabled", "equals": true},
		{"op": "capture_frame", "name": "add-spell-open"},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "addSpell", "field": "controller_selection_active", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "addSpell", "field": "focus_index", "equals": 1},
		{"op": "assert", "probe": "addSpell", "field": "focused_enabled", "equals": true},
		{"op": "wait_until", "probe": "addSpell", "field": "accept_visual_visible", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "addSpell", "field": "accept_glyph_text", "equals": "Add"},
		{"op": "assert", "probe": "addSpell", "field": "cancel_glyph_text", "equals": "Cancel"},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": false},
		{"op": "capture_frame", "name": "add-spell-controller-mode"},
		{"op": "press", "device": "pad0", "control": "south"},
		{"op": "wait_frames", "frames": 2},
		{"op": "capture_frame", "name": "add-spell-controller-pressed"},
		{"op": "release", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "domain", "field": "spell_count", "equals": 1, "timeout_ms": 2000},
		{"op": "assert", "probe": "domain", "field": "target_spell_present", "equals": true},
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": false, "timeout_ms": 2000},
		{"op": "assert", "probe": "runtime", "field": "cursor_visible", "equals": true},
		{"op": "assert_event_count", "kind": "controller_button_down", "count": 2},
		{"op": "request_shutdown"}
	]
}
