{
	"schema": "vcmi.controller-e2e/v1",
	"id": "battle.v3.action-radial-contract",
	"profile": "dualsense",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260827}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "battle-e2e",
		"autofightPlayers": ["blue"]
	},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "runtime", "field": "top_window", "changes": true, "timeout_ms": 60000},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "controller", "timeout_ms": 10000},
		{"op": "wait_until", "probe": "battle", "field": "open", "equals": true, "timeout_ms": 20000},
		{"op": "wait_until", "probe": "battle", "field": "focus_hex", "equals": 36, "timeout_ms": 20000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "action_radial.has_wait", "equals": true},
		{"op": "assert", "probe": "battle", "field": "action_radial.has_defend", "equals": true},
		{"op": "assert", "probe": "battle", "field": "action_radial.has_autocombat", "equals": true},
		{"op": "assert", "probe": "battle", "field": "action_radial.items.wait.enabled", "equals": true},
		{"op": "assert", "probe": "battle", "field": "action_radial.items.defend.enabled", "equals": true},
		{"op": "assert", "probe": "battle", "field": "action_radial.items.autocombat.enabled", "equals": true},
		{"op": "capture_frame", "name": "m3-2-radial-dualsense-neutral"},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "battle", "field": "action_radial.open", "equals": true},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": -1.0},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.selected", "equals": "wait", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "m3-2-radial-wait-selected"},
		{"op": "set_axis", "device": "pad0", "control": "right_stick_x", "value": 1.0},
		{"op": "assert_unchanged", "probe": "battle", "field": "action_radial.selected", "frames": 8},
		{"op": "tap", "device": "pad0", "control": "dpad_right"},
		{"op": "assert", "probe": "battle", "field": "action_radial.selected", "equals": "wait"},
		{"op": "assert", "probe": "battle", "field": "focus_hex", "equals": 36},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "neutralize", "device": "pad0"},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.selected", "equals": "defend", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "move_mouse", "x": 400, "y": 300},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "keyboard_and_mouse", "timeout_ms": 3000},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": false, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "battle", "field": "commands_sent", "equals": 0},
		{"op": "neutralize", "device": "pad0"},
		{"op": "tap", "device": "pad0", "control": "ps"},
		{"op": "wait_until", "probe": "runtime", "field": "input_mode", "equals": "controller", "timeout_ms": 3000},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": -1.0},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.selected", "equals": "wait", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "press", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "action_radial.confirm_pressed", "equals": true, "timeout_ms": 3000},
		{"op": "capture_frame", "name": "m3-2-radial-wait-confirm-pressed"},
		{"op": "release", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "battle", "field": "commands_sent", "equals": 1, "timeout_ms": 3000},
		{"op": "assert", "probe": "battle", "field": "last_command.name", "equals": "wait"},
		{"op": "assert", "probe": "battle", "field": "action_radial.open", "equals": false},
		{"op": "request_shutdown"}
	]
}
