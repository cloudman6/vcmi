{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m4.adventure.disembark-spatial-access",
	"profile": "dualsense",
	"settingsOverride": {"input": {"enableMouse": true}, "server": {"seed": 20260904}},
	"timeout_ms": 90000,
	"fixture": {"setup": "battle-map-start", "map": "adventure-visible-enemy-e2e", "autofightPlayers": []},
	"prelude": [{"op": "attach", "device": "pad0", "profile": "dualsense"}],
	"steps": [
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 60000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "l1"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": 2, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "l1"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "actor_id", "equals": 3, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_kind", "equals": "hero"},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_visitable_x", "equals": 26},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_visitable_y", "equals": 27},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_in_boat", "equals": true},
		{"op": "assert", "probe": "runtime", "field": "cursor_id", "equals": "mapHero"},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "scene", "field": "hero_window_open", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_id", "equals": 3},
		{"op": "set_axis", "device": "pad0", "control": "r2", "value": 1.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.open", "equals": true, "timeout_ms": 3000},
		{"op": "assert", "probe": "controller_object_focus", "field": "context_radial.item_count", "equals": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "context_radial.sequence_csv", "equals": "move,end_turn,sleep_wake"},
		{"op": "neutralize", "device": "pad0"},
		{"op": "tap", "device": "pad0", "control": "east"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "context_radial.open", "equals": false, "timeout_ms": 3000},
		{"op": "set_axis", "device": "pad0", "control": "left_stick_x", "value": -1.0},
		{"op": "wait_until", "probe": "runtime", "field": "cursor_id", "equals": "mapTurn1Disembark", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_id", "equals": 3},
		{"op": "capture_frame", "name": "adventure-disembark-spatial-target"},
		{"op": "request_shutdown"}
	]
}
