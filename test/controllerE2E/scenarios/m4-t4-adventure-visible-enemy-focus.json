{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m4.t4.adventure.visible-enemy-focus",
	"profile": "dualsense",
	"settingsOverride": {
		"input": {"enableMouse": true},
		"server": {"seed": 20260904}
	},
	"timeout_ms": 90000,
	"fixture": {
		"setup": "battle-map-start",
		"map": "adventure-visible-enemy-e2e",
		"autofightPlayers": []
	},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "scene", "field": "adventure_ready", "equals": true, "timeout_ms": 60000, "stable_for_frames": 3},
		{"op": "assert", "probe": "controller_object_focus", "field": "kind", "equals": "hero"},
		{"op": "assert", "probe": "controller_object_focus", "field": "visible_enemy_hero_count", "equals": 1},
		{"op": "set_axis", "device": "pad0", "control": "right_stick_x", "value": 1.0},
		{"op": "set_axis", "device": "pad0", "control": "right_stick_y", "value": -1.0},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "kind", "equals": "enemy_hero", "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "neutralize", "device": "pad0"},
		{"op": "assert", "probe": "controller_object_focus", "field": "actor_kind", "equals": "hero"},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "checkpoint", "name": "after-primary-release"},
		{"op": "wait_until", "probe": "controller_object_focus", "field": "path_matches_interaction_target", "equals": true, "timeout_ms": 3000, "stable_for_frames": 3},
		{"op": "capture_frame", "name": "adventure-visible-enemy-focus"},
		{"op": "request_shutdown"}
	]
}
