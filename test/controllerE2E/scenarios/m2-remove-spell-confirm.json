{
	"schema": "vcmi.controller-e2e/v1",
	"id": "m2.remove-spell.confirm",
	"profile": "dualsense",
	"timeout_ms": 30000,
	"fixture": {"setup": "battle-only-remove-spell", "preselected": [0, 1, 2]},
	"prelude": [
		{"op": "attach", "device": "pad0", "profile": "dualsense"}
	],
	"steps": [
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": true, "timeout_ms": 10000},
		{"op": "assert", "probe": "domain", "field": "spell_count", "equals": 3},
		{"op": "assert", "probe": "addSpell", "field": "focus_index", "equals": 0},
		{"op": "tap", "device": "pad0", "control": "dpad_down"},
		{"op": "wait_until", "probe": "addSpell", "field": "controller_selection_active", "equals": true, "timeout_ms": 2000},
		{"op": "assert", "probe": "addSpell", "field": "accept_glyph_text", "equals": "Remove"},
		{"op": "assert", "probe": "addSpell", "field": "cancel_glyph_text", "equals": "Cancel"},
		{"op": "capture_frame", "name": "remove-spell-controller-mode"},
		{"op": "tap", "device": "pad0", "control": "south"},
		{"op": "wait_until", "probe": "domain", "field": "spell_count", "equals": 2, "timeout_ms": 2000},
		{"op": "assert", "probe": "domain", "field": "target_spell_present", "equals": false},
		{"op": "wait_until", "probe": "addSpell", "field": "open", "equals": false, "timeout_ms": 2000},
		{"op": "request_shutdown"}
	]
}
